FROM python:3.12-slim-bullseye

# Debian 11 (bullseye) left LTS on 31 Aug 2026. Its pool is being purged from the live
# mirrors (bullseye-security .deb files 404 on deb.debian.org and security.debian.org
# alike since 5 Sep 2026, failing every Linux build) and the suites live on
# archive.debian.org, whose Release files are no longer re-signed. Fetch from the
# archive and skip the expiry check; drop bullseye-security, which the archive does
# not carry yet and which nothing below needs.
#
# Every locked dependency ships a manylinux wheel for x86_64 and aarch64 (uv.lock), so
# no compiler or Rust toolchain is installed; PyInstaller only needs objdump (binutils).
# A future sdist-only dependency fails here with "no compiler" instead of building.
RUN set -eu; \
    sed -i -e '/bullseye-security/d' -e 's|http://deb.debian.org/debian|http://archive.debian.org/debian|' /etc/apt/sources.list; \
    apt-get update -o Acquire::Check-Valid-Until=false -o Acquire::Retries=3; \
    apt-get install -y --no-install-recommends -o Acquire::Retries=3 binutils; \
    rm -rf /var/lib/apt/lists/*

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY . .

RUN uv sync --frozen --extra dev --extra provider
RUN uv run pyinstaller lium.spec --clean
