FROM python:3.12-slim-bullseye

# Debian 11 (bullseye) left LTS on 31 Aug 2026: its apt suites are frozen and being
# moved to archive.debian.org, and while that happens the deb.debian.org CDN can serve
# an index that lists files a pool edge no longer has (404 on libssl1.1/libperl5.32
# failed every amd64 build on 5 Sep 2026). Retry update+install with a fresh index,
# do not fail on the frozen suites' expiring Release files, and from the third try
# fetch the security suite under its own hostname (a different CDN cache key).
# --fix-missing is not used on purpose: it would continue without libssl-dev.
RUN set -eu; \
    for attempt in 1 2 3 4 5; do \
        if apt-get update -o Acquire::Retries=3 -o Acquire::Check-Valid-Until=false \
            && apt-get install -y --no-install-recommends -o Acquire::Retries=3 \
                build-essential \
                curl \
                pkg-config \
                libssl-dev; then \
            break; \
        fi; \
        if [ "$attempt" -ge 5 ]; then echo "apt-get failed after $attempt attempts" >&2; exit 1; fi; \
        if [ "$attempt" -eq 2 ]; then \
            sed -i 's|http://deb.debian.org/debian-security|http://security.debian.org/debian-security|' /etc/apt/sources.list; \
        fi; \
        echo "apt-get attempt $attempt failed; retrying in $((attempt * 15))s" >&2; \
        sleep $((attempt * 15)); \
    done; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y; \
    rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"

RUN pip install --no-cache-dir uv

WORKDIR /app
COPY . .

RUN uv sync --frozen --extra dev --extra provider
RUN uv run pyinstaller lium.spec --clean
